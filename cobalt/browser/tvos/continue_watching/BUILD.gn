import("//cobalt/app/tvos/bundle.gni")

source_set("store") {
  sources = [
    "continue_watching_entry.h",
    "continue_watching_entry.mm",
    "continue_watching_link.h",
    "continue_watching_link.mm",
    "continue_watching_store.h",
    "continue_watching_store.mm",
  ]

  defines = [ "CONTINUE_WATCHING_APP_GROUP=\"$cobalt_app_group\"" ]

  frameworks = [ "Foundation.framework" ]
}

source_set("recorder") {
  sources = [
    "continue_watching_recorder.h",
    "continue_watching_recorder.mm",
  ]

  deps = [
    ":store",
    "//base",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
    "//net",
    "//services/media_session/public/cpp",
    "//services/media_session/public/mojom",
    "//ui/gfx/geometry",
    "//url",
  ]

  frameworks = [
    "Foundation.framework",
    "TVServices.framework",
    "UIKit.framework",
  ]
}
