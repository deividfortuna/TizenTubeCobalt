import("//build/apple/compile_entitlements.gni")
import("//build/config/ios/rules.gni")
import("//cobalt/app/tvos/bundle.gni")

compile_entitlements("entitlements") {
  substitutions = [ "COBALT_APP_GROUP=$cobalt_app_group" ]
  output_name = "$target_gen_dir/top_shelf.appex.entitlements"
  entitlements_templates = [ "entitlements.plist" ]
}

ios_appex_bundle("top_shelf") {
  output_name = "DedTubeTopShelf"

  sources = [ "top_shelf_content_provider.mm" ]

  deps = [ "//cobalt/browser/tvos/continue_watching:store" ]

  frameworks = [
    "Foundation.framework",
    "TVServices.framework",
  ]

  bundle_identifier = "$cobalt_bundle_identifier.topshelf"
  entitlements_target = ":entitlements"
  extra_substitutions = cobalt_bundle_version_substitutions
  info_plist = "Info.plist"
}
